              "value": "={{ $json.From.match(/<(.+)>/) ? $json.From.match(/<(.+)>/)[1] : $json.fieldName }}",
              "type": "string"
            },
            {
              "id": "3676db6b-c079-4883-a2ba-9c7c6ed78d6e",
              "name": "email_body",
              "value": "={{\n(() => {\n  const raw = $('Gmail Trigger').item.json.snippet || '';\n\n  // فك ترميز الـ HTML entities\n  let dec = raw\n    .replace(/&lt;/g, '<')\n    .replace(/&gt;/g, '>')\n    .replace(/&amp;/g, '&')\n    .replace(/&#39;/g, \"'\")\n    .replace(/&quot;/g, '\"');\n\n  // شيل الرموز المخفية (bidi control characters) اللي جيميل بيضيفها\n  dec = dec.replace(/[\\u200E\\u200F\\u202A-\\u202E]/g, '');\n\n  // شيل الجزء المقتبس اللي بيبدأ بـ \"On ... wrote:\" - من غير شرط بداية السطر\n  const cleaned = dec.replace(/\\bOn\\s.+?wrote:[\\s\\S]*/is, '').trim();\n\n  return cleaned;\n})()\n}}",
              "type": "string"
            },
            {
              "id": "e62b6b48-6fb7-411e-8886-71fc2a6c7828",
              "name": "notion_id",
